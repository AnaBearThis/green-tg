# Пример настроек. Скопируйте в .env (или .env.local) и измените нужное: cp .env.example .env
# Все VITE_* переменные попадают в собранный JS и видны любому посетителю.

# Шаблон apiUrl по умолчанию: {prefix} заменяется первыми 4 цифрами idInstance (4100… → 4100.api.green-api.com)
VITE_API_URL_TEMPLATE=https://{prefix}.api.green-api.com
# apiUrl, если idInstance короче 4 цифр
VITE_API_URL_FALLBACK=https://api.green-api.com
# Ссылка на личный кабинет на экране входа
VITE_CONSOLE_URL=https://console.green-api.com
# Пауза перед повторным запросом очереди уведомлений после ошибки, мс
VITE_POLL_RETRY_MS=5000
# Префикс ключей localStorage
VITE_STORAGE_PREFIX=green-tg

# --- Только для локальной разработки: автозаполнение формы входа. Не указывайте токен для публичной сборки ---
VITE_ID_INSTANCE=
VITE_API_TOKEN_INSTANCE=
VITE_API_URL=
